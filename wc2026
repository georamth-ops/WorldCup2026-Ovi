/* ── HELPERS ── */
const toUAE = utc => { try { return new Date(utc).toLocaleString('en-GB',{timeZone:'Asia/Dubai',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})+' UAE'; } catch(ex) { return utc; } };
const toUTC = utc => { try { return new Date(utc).toLocaleString('en-GB',{timeZone:'UTC',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})+' UTC'; } catch(ex) { return utc; } };

function useCountdown(utc) {
  const [ms, setMs] = useState(new Date(utc) - new Date());
  useEffect(() => {
    const t = setInterval(() => setMs(new Date(utc) - new Date()), 1000);
    return () => clearInterval(t);
  }, [utc]);
  if (ms <= 0) return null;
  return { d:Math.floor(ms/86400000), h:Math.floor((ms%86400000)/3600000), m:Math.floor((ms%3600000)/60000), s:Math.floor((ms%60000)/1000), ms };
}

function calcPts(bid, result, penWinner) {
  if (!bid || !result) return null;
