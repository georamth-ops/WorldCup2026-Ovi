/* ══ MAIN APP ══════════════════════════════════════════════════════════════ */
function App() {
  const [user, setUser] = useState(null);
  const [tab, setTab] = useState('matches');
  const [stageFilter, setStageFilter] = useState('group48');
  const [matches, setMatches] = useState([]);
  const [allUsers, setAllUsers] = useState([]);
  const [userBids, setUserBids] = useState({});
  const [notifications, setNotifications] = useState([]);
  const [showRules, setShowRules] = useState(false);
  const [showConfetti, setShowConfetti] = useState(false);
  const [nudgeSent, setNudgeSent] = useState({});
  const [nudgeMsg, setNudgeMsg] = useState('');
  const [loading, setLoading] = useState(true);
  const [liveData, setLiveData] = useState('');
  const [fetchingLive, setFetchingLive] = useState(false);

  useEffect(() => {
    const stored = localStorage.getItem('wc2026_session');
    if (stored) { try { setUser(JSON.parse(stored)); } catch(ex) {} }
    loadMatches();
    loadUsers();
  }, []);

  useEffect(() => {
    if (!user) return;
    loadBids();
    if (user.id !== 'admin-static') loadNotifications();
    const ch = sb.channel('wc2026-rt')
      .on('postgres_changes',{event:'*',schema:'public',table:'matches'}, () => loadMatches())
      .on('postgres_changes',{event:'*',schema:'public',table:'users'},   () => loadUsers())
      .on('postgres_changes',{event:'*',schema:'public',table:'bids'},    () => loadBids())
      .on('postgres_changes',{event:'INSERT',schema:'public',table:'notifications'}, () => { if(user.id!=='admin-static') loadNotifications(); })
      .subscribe();
    return () => sb.removeChannel(ch);
  }, [user?.id]);

  const loadMatches = async () => {
    const {data} = await sb.from('matches').select('*').order('utc');
    if (data) setMatches(data);
    setLoading(false);
  };
  const loadUsers = async () => {
    const {data} = await sb.from('users').select('id,username,display_name,points').order('points',{ascending:false});
    if (data) setAllUsers(data);
  };
  const loadBids = async () => {
    if (!user || user.id==='admin-static') return;
    const {data} = await sb.from('bids').select('*').eq('user_id', user.id);
    if (data) { const m={}; data.forEach(b => m[b.match_id]=b); setUserBids(m); }
  };
  const loadNotifications = async () => {
    if (!user || user.id==='admin-static') return;
    const {data} = await sb.from('notifications').select('*').eq('to_user_id',user.id).eq('read',false).order('created_at',{ascending:false}).limit(5);
    if (data) setNotifications(data);
  };

  const handleLogin = u => { setUser(u); localStorage.setItem('wc2026_session', JSON.stringify(u)); };
  const handleLogout = () => { setUser(null); localStorage.removeItem('wc2026_session'); setUserBids({}); setNotifications([]); };

  const handleBid = async (matchId, bidData) => {
    if (!user || user.id==='admin-static') return;
    const {error} = await sb.from('bids').insert({user_id:user.id, match_id:matchId, ...bidData, points_earned:0});
    if (!error) loadBids();
  };

  const handleAdminResult = async (matchId, af) => {
    const match = matches.find(m => m.id === matchId);
    if (!match) return;
    const hs = parseInt(af.homeScore)||0;
    const as_ = parseInt(af.awayScore)||0;
    let dbResult = af.result;
    let penWinner = null;
    if (af.result==='draw_pen_home') { dbResult='draw'; penWinner=match.home; }
    else if (af.result==='draw_pen_away') { dbResult='draw'; penWinner=match.away; }
    await sb.from('matches').update({home_score:hs, away_score:as_, result:dbResult, penalty_winner:penWinner, status:'finished'}).eq('id', matchId);
    const {data:bids} = await sb.from('bids').select('*').eq('match_id', matchId);
    if (bids) {
      for (const bid of bids) {
        let pts = 0;
        if (bid.bid_type === dbResult) pts += 3;
        if (dbResult==='draw' && bid.penalty_team && penWinner && bid.penalty_team===penWinner) pts += 6;
        await sb.from('bids').update({points_earned:pts}).eq('id', bid.id);
        if (pts > 0) {
          const {data:u} = await sb.from('users').select('points').eq('id', bid.user_id).single();
          if (u) await sb.from('users').update({points:(u.points||0)+pts}).eq('id', bid.user_id);
        }
      }
    }
    const {data:allU} = await sb.from('users').select('id,display_name');
    if (allU) {
      const notifs = allU.map(u => ({to_user_id:u.id, from_user:'System', message:'⚽ Match ended: '+match.home+' '+hs+'–'+as_+' '+match.away+'. Points updated!'}));
      await sb.from('notifications').insert(notifs);
    }
    loadMatches(); loadUsers();
  };

  const handleNudge = async target => {
    if (!user) return;
    await sb.from('notifications').insert({to_user_id:target.id, from_user:user.display_name||user.username, message:'Hey '+(target.display_name||target.username)+'! 👋 Don\'t forget your predictions! ⚽🏆'});
    setNudgeSent(n => ({...n, [target.id]:true}));
    setNudgeMsg('Nudge sent to '+(target.display_name||target.username)+'! 👋');
    setTimeout(() => setNudgeMsg(''), 3500);
  };

  const dismissNotif = async id => {
    await sb.from('notifications').update({read:true}).eq('id', id);
    setNotifications(n => n.filter(x => x.id !== id));
  };

  const fetchLiveData = async () => {
    setFetchingLive(true);
    try {
      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          model:'claude-sonnet-4-20250514', max_tokens:800,
          tools:[{type:'web_search_20250305',name:'web_search'}],
          messages:[{role:'user',content:'Search FIFA official website for World Cup 2026 latest match schedule and scores. Give me 4-6 bullet points with upcoming fixtures and recent results.'}]
        })
      });
      const d = await res.json();
      const text = d.content?.filter(c=>c.type==='text').map(c=>c.text).join('\n') || 'Check fifa.com for the latest.';
      setLiveData(text);
    } catch(ex) { setLiveData('Could not fetch data. Please visit fifa.com directly.'); }
    setFetchingLive(false);
  };

  if (!user) return e(AuthScreen, {onLogin:handleLogin});

  if (loading) return e('div', {className:'full-loader'},
    e('div', {style:{fontSize:56}}, '🏆'),
    e(Spinner, {style:{width:34,height:34}}),
    e('p', {style:{color:'var(--text2)',fontSize:14}}, 'Loading World Cup 2026…')
  );

  const currentPoints = allUsers.find(u2 => u2.id===user.id)?.points || user.points || 0;
  const topUser = allUsers[0];
  const isChampion = topUser && user && topUser.id===user.id && currentPoints>0;
  const filteredMatches = matches.filter(m => m.stage===stageFilter);

  const TABS = [
    ['matches','⚽ Matches'],
    ['leaderboard','🏆 Leaderboard'],
    ['groups','Group Teams'],
    ['stages','All Stages'],
    ['fifa','FIFA'],
    ...(user.is_admin ? [['admin','⚙️ Admin']] : []),
  ];

  return e('div', {className:'app'},
    /* TOPBAR */
    e('div', {className:'topbar'},
      e('div', {className:'logo'},
        e('span', null, 'World Cup 2026'),
        e('span', {className:'logo-badge'}, 'PREDICTION LEAGUE')
      ),
      e('div', {className:'nav'},
        ...TABS.map(([id,lbl]) => e('button', {key:id, className:'nav-btn'+(tab===id?' active':''), onClick:()=>setTab(id)}, lbl))
      ),
      e('div', {className:'user-pill'},
        e('div', {className:'avatar'}, (user.display_name||user.username)?.[0]?.toUpperCase()||'?'),
        e('span', {style:{fontSize:12,maxWidth:90,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}, user.display_name||user.username),
        e('span', {className:'badge badge-gold', style:{fontSize:11}}, currentPoints+' pts'),
        e('button', {className:'btn btn-xs btn-outline', onClick:handleLogout}, 'Out')
      )
    ),

    /* NUDGE BANNER */
    nudgeMsg && e('div', {className:'notif-bar'}, nudgeMsg),

    /* NOTIFICATIONS */
    notifications.length > 0 && e('div', {style:{background:'var(--surface2)',borderBottom:'1px solid var(--border)'}},
      ...notifications.slice(0,3).map(n =>
        e('div', {key:n.id, className:'notif-item'},
          e('span', {style:{fontSize:14}}, '🔔'),
          e('span', {style:{flex:1,color:'var(--text2)'}}, e('strong',{style:{color:'var(--text)'}},n.from_user), ': '+n.message),
          e('button', {className:'btn btn-xs btn-outline', onClick:()=>dismissNotif(n.id)}, '✕')
        )
      )
    ),

    /* MAIN */
    e('div', {className:'main'},

      /* MATCHES */
      tab==='matches' && e('div', null,
        e('div', {style:{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:14,flexWrap:'wrap',gap:8}},
          e('h2', {className:'section-title', style:{margin:0}}, 'Matches'),
          e('button', {className:'btn btn-outline btn-sm', onClick:fetchLiveData, disabled:fetchingLive},
            fetchingLive ? e(Spinner) : '🔄 Live Update'
          )
        ),
        liveData && e('div', {className:'card-sm', style:{marginBottom:14,fontSize:12,color:'var(--text2)',lineHeight:1.75,whiteSpace:'pre-wrap'}},
          e('div', {style:{fontSize:10,color:'var(--gold)',fontWeight:600,letterSpacing:'.08em',marginBottom:6}}, 'LIVE DATA — FIFA.COM'),
          liveData
        ),
        e('div', {className:'tab-bar'},
          ...STAGES.map(s => e('button', {key:s.id, className:'tab'+(stageFilter===s.id?' active':''), onClick:()=>setStageFilter(s.id)}, s.short))
        ),
        filteredMatches.length===0
          ? e('div', {className:'empty'}, e('div',{style:{fontSize:40,marginBottom:10}},'⚽'), e('p',null,'No matches in this stage yet.'), e('p',{style:{fontSize:11,marginTop:6,color:'var(--text4)'}},'Admin adds matches via Supabase.'))
          : e('div', null, ...filteredMatches.map(m => e(MatchCard, {key:m.id, match:m, userBid:userBids[m.id]||null, onBid:handleBid, isAdmin:!!user.is_admin, onAdminResult:handleAdminResult})))
      ),

      /* LEADERBOARD */
      tab==='leaderboard' && e('div', null,
        isChampion && e('div', {className:'alert alert-info', style:{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:16}},
          e('span', null, '🏆 You are currently #1 on the leaderboard!'),
          e('button', {className:'btn btn-gold btn-sm', onClick:()=>setShowConfetti(true)}, 'Celebrate 🎉')
        ),
        e(Leaderboard, {users:allUsers, currentUser:user, onNudge:handleNudge, nudgeSent})
      ),

      tab==='groups' && e(GroupTeams),
      tab==='stages' && e(AllStages, {matches}),
      tab==='fifa'   && e(FifaTab, {liveData, fetchingLive, onFetch:fetchLiveData}),
      tab==='admin' && user.is_admin && e(AdminPanel, {matches, allUsers, onAdminResult:handleAdminResult, stageFilter, setStageFilter})
    ),

    /* FLOATING RULES BTN */
    e('button', {className:'rules-fab', onClick:()=>setShowRules(true), title:'View Bidding Rules'}, '📋'),

    showRules    && e(RulesModal, {onClose:()=>setShowRules(false), resizable:true}),
    showConfetti && e(Confetti,   {onClose:()=>setShowConfetti(false)})
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(e(App));
</script>
</body>
</html>
