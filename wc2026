.modal.resizable{resize:both;overflow:auto;min-width:300px;min-height:200px}
.confetti-overlay{position:fixed;inset:0;z-index:300;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,0,0,.9)}
