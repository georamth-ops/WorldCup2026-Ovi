.trophy-anim{font-size:110px;animation:tbounce 1s ease infinite alternate;display:block}
@keyframes tbounce{0%{transform:scale(1) rotate(-4deg)}100%{transform:scale(1.08) rotate(4deg)}}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid var(--border2);border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
