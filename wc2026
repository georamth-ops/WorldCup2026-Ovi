    const {data, error} = await sb.from('users').select('*').eq('username',form.username.trim()).eq('passcode',form.passcode).maybeSingle();
    setLoading(false);
    if (error || !data) { setErr('Incorrect username or passcode.'); return; }
    onLogin(data);
  };

  const doCreate = async () => {
    setErr(""); setMsg("");
    if (!form.username.trim()) { setErr("Username is required."); return; }
    if (!form.passcode) { setErr("Passcode is required."); return; }
    if (!form.email.trim()) { setErr("Email is required."); return; }
    setLoading(true);
    try {
      const {data:ex, error:chkErr} = await sb.from("users").select("id").eq("username",form.username.trim()).maybeSingle();
      if (chkErr) { setErr("DB check error: " + chkErr.message); setLoading(false); return; }
      if (ex) { setErr("Username already taken. Please choose another."); setLoading(false); return; }
      const {data, error} = await sb.from("users").insert({username:form.username.trim(),passcode:form.passcode,email:form.email.trim().toLowerCase(),display_name:form.username.trim(),points:0}).select().single();
      setLoading(false);
      if (error) { setErr("Error: " + error.message + " (code: " + error.code + ")"); return; }
      if (!data) { setErr("Account created but sign-in failed. Please try Sign In."); return; }
      onLogin(data);
    } catch(ex2) {
      setLoading(false);
      setErr("Unexpected error: " + (ex2.message || String(ex2)));
    }
  };

  const doForgot = async () => {
    setErr(''); setMsg('');
    if (!form.email.trim()) { setErr('Enter your recovery email.'); return; }
    setLoading(true);
    const {data} = await sb.from('users').select('username').eq('email',form.email.trim().toLowerCase()).maybeSingle();
    setLoading(false);
    if (data) setMsg('Found it! Your username is: "'+data.username+'"');
    else setErr('No account found with that email.');
  };

  return e('div', {className:'auth-wrap'},
    e('div', {className:'auth-box'},
      e('div', {style:{textAlign:'center',marginBottom:28}},
        e('div', {style:{fontSize:58,marginBottom:8}}, '🏆'),
        e('h1', {style:{fontFamily:'Bebas Neue',fontSize:36,color:'var(--gold)',letterSpacing:'.1em'}}, 'World Cup 2026'),
        e('p', {style:{color:'var(--text2)',fontSize:13,marginTop:4}}, 'Prediction League — Bid. Score. Win.')
      ),
      e('div', {className:'card'},
        e('div', {className:'auth-tabs'},
          e('button', {className:'auth-tab'+(mode==='login'?' active':''), onClick:()=>{setMode('login');setErr('');setMsg('');}}, 'Sign In'),
          e('button', {className:'auth-tab'+(mode==='create'?' active':''), onClick:()=>{setMode('create');setErr('');setMsg('');}}, 'Create Account'),
          e('button', {className:'auth-tab'+(mode==='forgot'?' active':''), onClick:()=>{setMode('forgot');setErr('');setMsg('');}}, 'Forgot?')
        ),
        err && e('div', {className:'alert alert-error'}, '⚠️ '+err),
        msg && e('div', {className:'alert alert-success'}, '✅ '+msg),
        mode==='login' && e('div', null,
          e('div', {className:'input-group'}, e('label', null, 'Username'), e('input', {value:form.username, onChange:ev=>set('username',ev.target.value), placeholder:'your username'})),
          e('div', {className:'input-group'}, e('label', null, 'Passcode'), e('input', {type:'password', value:form.passcode, onChange:ev=>set('passcode',ev.target.value), placeholder:'••••••', onKeyDown:ev=>ev.key==='Enter'&&doLogin()})),
          e('button', {className:'btn btn-gold', style:{width:'100%',padding:'11px',justifyContent:'center'}, onClick:doLogin, disabled:loading}, loading ? e(Spinner) : 'Sign In →')
        ),
        mode==='create' && e('div', null,
          e('div', {className:'input-group'}, e('label', null, 'Username'), e('input', {value:form.username, onChange:ev=>set('username',ev.target.value), placeholder:'choose a username'})),
          e('div', {className:'input-group'}, e('label', null, 'Passcode'), e('input', {type:'password', value:form.passcode, onChange:ev=>set('passcode',ev.target.value), placeholder:'create a passcode'})),
          e('div', {className:'input-group'}, e('label', null, 'Recovery Email'), e('input', {type:'email', value:form.email, onChange:ev=>set('email',ev.target.value), placeholder:'your@email.com'})),
          e('button', {className:'btn btn-gold', style:{width:'100%',padding:'11px',justifyContent:'center'}, onClick:doCreate, disabled:loading}, loading ? e(Spinner) : 'Create Account →')
        ),
        mode==='forgot' && e('div', null,
          e('p', {style:{fontSize:12,color:'var(--text2)',marginBottom:12}}, 'Enter your recovery email to find your username.'),
          e('div', {className:'input-group'}, e('label', null, 'Recovery Email'), e('input', {type:'email', value:form.email, onChange:ev=>set('email',ev.target.value), placeholder:'your@email.com'})),
          e('button', {className:'btn btn-gold', style:{width:'100%',padding:'11px',justifyContent:'center'}, onClick:doForgot, disabled:loading}, loading ? e(Spinner) : 'Find My Account →')
        )
