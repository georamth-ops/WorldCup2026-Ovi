/* ── MATCH CARD ── */
function MatchCard({match, userBid, onBid, isAdmin, onAdminResult}) {
  const cd = useCountdown(match.utc);
  const isClosed = !cd || (cd.ms < 300000);
  const opts = BID_OPTS[match.stage] || ['win','draw'];
  const [showPenalty, setShowPenalty] = useState(false);
  const [saving, setSaving] = useState(false);
  const [showAdmin, setShowAdmin] = useState(false);
  const [af, setAf] = useState({homeScore:'',awayScore:'',result:''});
  const stage = STAGES.find(s => s.id === match.stage);
  const pts = calcPts(userBid, match.result, match.penalty_winner);

  const placeBid = async (type, penTeam) => {
    if (saving || userBid) return;
    setSaving(true);
    await onBid(match.id, {bid_type:type, penalty_team:penTeam||null});
    setSaving(false);
    setShowPenalty(false);
  };

  const handleDraw = () => { if (opts.includes('penalty')) setShowPenalty(true); else placeBid('draw', null); };

  const applyAdmin = async () => { await onAdminResult(match.id, af); setShowAdmin(false); };

  const scoreText = match.home_score != null ? match.home_score+' – '+match.away_score : 'VS';

  return e('div', {className:'match-card'},
    e('div', {className:'match-header'},
      e('div', {style:{display:'flex',gap:5,alignItems:'center',flexWrap:'wrap'}},
        stage && e('span', {className:'badge badge-gray'}, stage.short),
        match.match_group && e('span', {className:'badge badge-gray'}, 'Grp '+match.match_group),
        match.status==='live' && e('span', {className:'badge badge-live'}, e('span',{className:'live-dot'}), ' LIVE'),
        match.status==='finished' && e('span', {className:'badge badge-gray'}, '✓ Finished')
      ),
      pts !== null && e('span', {style:{fontSize:12,fontWeight:600,color:pts>0?'var(--green)':'var(--text3)'}}, pts>0 ? '+'+pts+' pts' : '0 pts')
    ),
    e('div', {className:'match-teams'},
      e('div', {className:'team-block'}, e('div',{className:'team-flag'},gf(match.home)), e('div',{className:'team-name'},match.home)),
      e('div', {className:'score-box'}, scoreText),
      e('div', {className:'team-block'}, e('div',{className:'team-flag'},gf(match.away)), e('div',{className:'team-name'},match.away))
    ),
    e('div', {className:'times-row'},
      e('span',{className:'time-chip'}, toUTC(match.utc)),
      e('span',{className:'time-chip'}, toUAE(match.utc))
    ),
    !userBid && !isClosed && e(CDDisplay, {utc:match.utc}),
    userBid && e('div', {className:'bid-result'},
      e('span', null, 'Your bid: ', e('strong', null,
        userBid.bid_type==='win' ? '🏆 '+match.home+' Win' :
        userBid.bid_type==='away_win' ? '🏆 '+match.away+' Win' : '🤝 Draw',
        userBid.penalty_team ? ' + Penalty: '+userBid.penalty_team : ''
      )),
      pts !== null && e('span', {style:{fontWeight:700,color:pts>0?'var(--green)':'var(--text3)'}}, '→ '+pts+' pts')
    ),
    !userBid && !isClosed && e('div', {className:'bid-buttons'},
      e('button', {className:'bid-btn', onClick:()=>placeBid('win',null), disabled:saving},
        saving ? e(Spinner) : e('span', null, gf(match.home)+' '+match.home+' Win')
      ),
      e('button', {className:'bid-btn', onClick:handleDraw, disabled:saving},
        saving ? e(Spinner) : e('span', null, '🤝 Draw'+(opts.includes('penalty') ? '\n+penalty?' : ''))
      ),
      e('button', {className:'bid-btn', onClick:()=>placeBid('away_win',null), disabled:saving},
        saving ? e(Spinner) : e('span', null, gf(match.away)+' '+match.away+' Win')
      )
    ),
    !userBid && isClosed && match.status!=='finished' && e('div', {className:'bid-closed'}, '🔒 Bidding closed'),
    showPenalty && !userBid && e('div', {className:'penalty-picker'},
      e('p', {style:{fontSize:12,color:'var(--text2)',marginBottom:10}}, 'You picked Draw. Pick penalty winner for +6 bonus points (optional):'),
      e('div', {style:{display:'flex',gap:6}},
        e('button', {className:'bid-btn', style:{flex:1}, onClick:()=>placeBid('draw',match.home)}, gf(match.home)+' '+match.home),
        e('button', {className:'bid-btn', style:{flex:1}, onClick:()=>placeBid('draw',match.away)}, gf(match.away)+' '+match.away),
        e('button', {className:'bid-btn', style:{flex:1,fontSize:10,color:'var(--text3)'}, onClick:()=>placeBid('draw',null)}, 'Skip')
      )
    ),
    isAdmin && e('div', {style:{marginTop:12,borderTop:'1px solid var(--border)',paddingTop:10}},
      e('button', {className:'btn btn-outline btn-sm', onClick:()=>setShowAdmin(!showAdmin)}, '⚙️ '+(showAdmin?'Hide':'Set Result')),
      showAdmin && e('div', {style:{marginTop:10,display:'grid',gridTemplateColumns:'1fr 1fr',gap:8}},
        e('div', {className:'input-group'}, e('label',null,'Home Score'), e('input',{type:'number',min:'0',value:af.homeScore,onChange:ev=>setAf(f=>({...f,homeScore:ev.target.value})),placeholder:'0'})),
        e('div', {className:'input-group'}, e('label',null,'Away Score'), e('input',{type:'number',min:'0',value:af.awayScore,onChange:ev=>setAf(f=>({...f,awayScore:ev.target.value})),placeholder:'0'})),
        e('div', {className:'input-group', style:{gridColumn:'1/-1'}},
          e('label',null,'Result'),
          e('select',{value:af.result,onChange:ev=>setAf(f=>({...f,result:ev.target.value}))},
            e('option',{value:''},'— select result —'),
            e('option',{value:'win'},match.home+' Win'),
            e('option',{value:'draw'},'Draw (no penalties)'),
            e('option',{value:'draw_pen_home'},'Draw → '+match.home+' wins penalties'),
            e('option',{value:'draw_pen_away'},'Draw → '+match.away+' wins penalties'),
            e('option',{value:'away_win'},match.away+' Win')
          )
        ),
        e('button', {className:'btn btn-green', style:{gridColumn:'1/-1',justifyContent:'center'}, onClick:applyAdmin}, '✓ Apply Result — Update All Points')
      )
    )
  );
}

